{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "types": ["bun-types"],
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "../../runtime/src/commander-tools/**/*.ts", "../../runtime/src/authority/**/*.ts", "../../runtime/src/security/**/*.ts"]
}
